# ============================================================
#  named_clocks — переменные окружения
#  Скопируй в .env и заполни своими значениями:
#    cp .env.example .env
# ============================================================

# --- Вход в само приложение (один пользователь) ---
APP_LOGIN=admin
APP_PASSWORD=ZtA9TuxwZYUtjPk5X8NJrMy0Z1YADBycS
# Секрет для подписи JWT сессии сайта (смени на случайную строку)
JWT_SECRET=change-me-to-a-long-random-string-ZtA9TuxwZYUtjPk5X8NJrMy0Z1YADBycS

# --- Postgres ---
POSTGRES_USER=clocks
POSTGRES_PASSWORD=clocksZtA9TuxwZYUtjPk5X8NJrMy0Z1YADBycS
POSTGRES_DB=clocks
# DSN, которым пользуется backend внутри docker-сети
DATABASE_URL=postgres://clocks:clocksZtA9TuxwZYUtjPk5X8NJrMy0Z1YADBycS@postgres:5432/clocks?sslmode=disable

# --- MinIO (S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123ZtA9TuxwZYUtjPk5X8NJrMy0Z1YADBycS
# Внутренний адрес MinIO (docker-сеть)
MINIO_ENDPOINT=minio:9000
# Публичный адрес, по которому браузер сможет скачать видео (presigned url)
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_BUCKET=videos
MINIO_USE_SSL=false

# --- Imanator (генерация изображений) ---
# API-ключ (Bearer). Возьми из личного кабинета imanator.pro
IMANATOR_API_KEY=random-key
IMANATOR_BASE_URL=https://imanator.pro

# --- OpenRouter (генерация видео) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель видео по умолчанию (список подтягивается с OpenRouter на фронт)
OPENROUTER_DEFAULT_MODEL=google/veo-3.1-lite
# Длительность клипа по умолчанию, сек (veo-3.1-lite поддерживает 4, 6, 8).
# Звук к видео добавляется отдельным этапом из медиатеки, поэтому модель
# запрашивается без аудио (generate_audio=false) — это заметно дешевле.
OPENROUTER_DEFAULT_DURATION=4
# Прокси для запросов к OpenRouter (если регион сервера заблокирован).
# Формат: http://user:pass@ip:port  (оставь пустым, чтобы ходить напрямую)
OPENROUTER_PROXY_URL=
# Таймаут одного HTTP-запроса к OpenRouter, сек (через прокси лучше побольше)
OPENROUTER_TIMEOUT_SECONDS=120

# --- ZaleyCash → VK Ads ---
# Секрет из настроек кабинета ZaleyCash. Пусто = интеграция выключена.
ZALEY_SECRET=
# Название кабинета ВКР, как в ZaleyCash (login). Не числовой id.
# Пример: Юлия тесты
ZALEY_ACCOUNT_NAME=
ZALEY_BASE_URL=https://zaleycash.com
VK_ADS_BASE_URL=https://ads.vk.com
# Хост кабинета в браузере — на него ведут ссылки из интерфейса.
VK_ADS_CABINET_URL=https://ads.vk.ru
# Переключатель кабинета в ссылках (?sudo=...). Пусто = берём из
# user.json как "<username>@agency_client".
VK_ADS_SUDO=
# За сколько секунд до expires_at обновлять токены
ZALEY_TOKEN_REFRESH_SKEW_SECONDS=120

# --- Курс валют ---
# Резервный курс USD→RUB. Используется, если не удалось получить
# актуальный курс с ЦБ РФ (cbr-xml-daily.ru).
USD_RUB_RATE=85

# --- Воркер ---
# Сколько задач обрабатывать параллельно
WORKER_CONCURRENCY=8
# Интервал поллинга статусов, сек
POLL_INTERVAL_SECONDS=2
# Таймаут ожидания одного этапа, сек (генерация видео может идти минутами)
STAGE_TIMEOUT_SECONDS=1800
# Срок аренды задачи воркером, сек. Через столько после смерти процесса
# незавершённая задача будет подхвачена заново с той же стадии.
LEASE_TIMEOUT_SECONDS=90
# Сколько всего попыток на задачу (первая + ретраи) при временных сбоях:
# недоступен OpenRouter, оборвалась сеть, 5xx. Постоянные ошибки не ретраятся.
MAX_TASK_ATTEMPTS=5

# --- Медиа (ffmpeg) ---
# Сколько процессов ffmpeg одновременно (кодирование грузит CPU)
FFMPEG_CONCURRENCY=3
# Каталог для временных файлов (пусто = системный)
MEDIA_TMP_DIR=
# Как растягивать видео под музыку:
#   interpolate — досинтезировать недостающие кадры по движению (плавно,
#                 но минуты CPU на клип);
#   duplicate   — держать существующие кадры дольше (почти бесплатно,
#                 но повторы кадров видны как дёрганье).
MEDIA_STRETCH_MODE=interpolate
# Максимальное замедление при подгонке видео под музыку.
# Выше лимита задача падает с понятной ошибкой, а не выдаёт слайд-шоу.
MEDIA_MAX_STRETCH_FACTOR=6
# Частота кадров итогового видео
MEDIA_OUTPUT_FPS=30
# Таймаут одного запуска ffmpeg, сек. Интерполяция 1080p-клипа занимает
# минуты, на слабой машине — кратно дольше.
MEDIA_FFMPEG_TIMEOUT_SECONDS=1800
# Лимиты загрузок, МБ
MEDIA_MAX_AUDIO_MB=50
MEDIA_MAX_VIDEO_UPLOAD_MB=500

# --- Сервер ---
HTTP_PORT=8080
